{
  "name": "xr-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run optimize:assets && vite --host 127.0.0.1 --open /",
    "optimize:assets": "node scripts/assets/optimize-assets.mjs",
    "prepare:content": "node scripts/content/generate-content-data.mjs",
    "check": "node scripts/check-links.mjs",
    "build": "npm run optimize:assets && npm run prepare:content && tsc && vite build && node scripts/prerender/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "allowScripts": {
    "sharp@0.35.4": true
  }
}
